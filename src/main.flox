# ====================================================================
# [Flox Benchmark Engine - 10k Print Test]
# ====================================================================
MATH_ZERO        = 0;
MATH_JEDEN       = 1;

print("--- [Flox Engine] START BENCHMARKU 10K PRINT ---");

# Konfiguracja pętli
liczba_iteracji = 10000;
i = 0;

# Konfiguracja Anti-DCE (Haszowanie)
kaskada_hash = 5381;
mnoznik_hasha = 33;

while i < liczba_iteracji
{
    # 1. Klasyczna operacja wypisywania (Wymuszamy użycie std::cout)
    print(i);

    # 2. Akumulacja Anti-DCE (Kompilator nie może wyciąć pętli)
    t_hash1 = kaskada_hash * mnoznik_hasha;
    kaskada_hash = t_hash1 + i;

    # Inkremetacja indeksu
    i = i + MATH_JEDEN;
}

print("--- BENCHMARK ZAKONCZONY ---");
print("Ostateczna bezpieczna suma kontrolna (Anti-DCE Hash):");
print(kaskada_hash);
print("====================================================");
kupsko;